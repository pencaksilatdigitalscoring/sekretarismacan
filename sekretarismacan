<!DOCTYPE html>
<html lang="id">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no">
    <title>Manajemen Loting - CAHAYA DIGITAL SCORING</title>
    <script src="https://cdn.tailwindcss.com"></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/js/all.min.js"></script>
    <!-- Library untuk Export PDF -->
    <script src="https://cdnjs.cloudflare.com/ajax/libs/html2pdf.js/0.10.1/html2pdf.bundle.min.js"></script>
    <!-- Library untuk Manajemen Excel (SheetJS) -->
    <script src="https://cdnjs.cloudflare.com/ajax/libs/xlsx/0.18.5/xlsx.full.min.js"></script>
    
    <style>
        @import url('https://fonts.googleapis.com/css2?family=Montserrat:wght@400;600;700;800&display=swap');
        body { 
            font-family: 'Montserrat', sans-serif; 
            background-color: #f8fafc; 
            color: #1e293b; 
            margin: 0; 
            height: 100vh; 
            width: 100vw; 
            overflow: hidden; 
            display: flex;
            flex-direction: column;
        }

        .custom-scroll { overflow-y: auto; overflow-x: auto; }
        .custom-scroll::-webkit-scrollbar { width: 4px; height: 4px; }
        .custom-scroll::-webkit-scrollbar-thumb { background: #cbd5e1; border-radius: 10px; }
        
        .save-notif { 
            position: fixed; 
            top: 20px; 
            right: 20px; 
            background: #10b981; 
            color: white; 
            padding: 15px 25px; 
            border-radius: 15px; 
            font-weight: bold; 
            transform: translateX(200%); 
            transition: 0.5s; 
            z-index: 60000; 
            box-shadow: 0 4px 6px -1px rgba(0, 0, 0, 0.1);
        }
        .save-notif.show { transform: translateX(0); }

        .label-sekre { font-size: 10px; font-weight: 800; color: #64748b; text-transform: uppercase; margin-bottom: 4px; display: block; }
        .input-loting { width: 100%; padding: 10px; border: 1px solid #cbd5e1; border-radius: 8px; font-size: 12px; font-weight: 700; outline: none; background-color: white; transition: all 0.3s; }
        .input-loting:focus { border-color: #e11d48; box-shadow: 0 0 0 2px rgba(225, 29, 72, 0.2); }

        /* TAB STYLE LOTING */
        .loting-tab-btn { flex: 1; padding: 15px 10px; font-size: 11px; font-weight: 800; text-transform: uppercase; border-bottom: 3px solid transparent; color: #94a3b8; transition: all 0.3s; text-align: center; }
        .loting-tab-btn.active { border-bottom-color: #e11d48; color: #e11d48; background: #fff1f2; }

        /* TABLE MOBILE ADJUSTMENTS */
        th, td { white-space: nowrap; }
    </style>
</head>
<body>

    <div id="save-ani" class="save-notif"><i class="fas fa-check-circle mr-2"></i> Data Tersimpan!</div>

    <!-- HEADER -->
    <div class="p-4 bg-white shadow-sm flex justify-between items-center border-b shrink-0">
        <div class="flex items-center gap-3">
            <div class="w-8 h-8 bg-rose-100 rounded-full flex items-center justify-center text-rose-600">
                <i class="fas fa-random"></i>
            </div>
            <h2 class="text-sm font-black uppercase italic text-rose-600 leading-tight">
                Manajemen<br><span class="text-[10px] text-slate-500">Loting Peserta</span>
            </h2>
        </div>
        <button onclick="clearAllParticipants()" class="bg-rose-50 border border-rose-200 text-rose-600 font-black text-[10px] px-3 py-2 rounded-xl active:scale-95 transition-all uppercase shadow-sm">
            <i class="fas fa-trash-alt mr-1"></i> Reset Data
        </button>
    </div>

    <!-- NAVIGATION TABS -->
    <div class="flex bg-white border-b shrink-0 shadow-sm z-10">
        <button id="lot-tab-1" onclick="switchLotingPage(1)" class="loting-tab-btn active"><i class="fas fa-user-plus sm:mr-2 block sm:inline mb-1 sm:mb-0 text-base sm:text-sm"></i> <span class="text-[8px] sm:text-[10px] block sm:inline mt-1 sm:mt-0">Input Data</span></button>
        <button id="lot-tab-2" onclick="switchLotingPage(2)" class="loting-tab-btn"><i class="fas fa-users sm:mr-2 block sm:inline mb-1 sm:mb-0 text-base sm:text-sm"></i> <span class="text-[8px] sm:text-[10px] block sm:inline mt-1 sm:mt-0">Data & Loting</span></button>
        <button id="lot-tab-3" onclick="switchLotingPage(3)" class="loting-tab-btn"><i class="fas fa-calendar-alt sm:mr-2 block sm:inline mb-1 sm:mb-0 text-base sm:text-sm"></i> <span class="text-[8px] sm:text-[10px] block sm:inline mt-1 sm:mt-0">Hasil Loting</span></button>
    </div>
    
    <!-- PAGE 1: INPUT DATA -->
    <div id="lot-page-1" class="flex-1 overflow-y-auto p-4 sm:p-6 bg-slate-50 flex flex-col items-center custom-scroll">
        <div class="w-full max-w-lg space-y-6 pb-10">
            
            <!-- Fitur Impor Excel Terhubung Panel Operator -->
            <div class="bg-white p-5 rounded-2xl border border-slate-200 shadow-sm">
                <h3 class="text-xs font-black uppercase text-slate-700 mb-3 flex items-center gap-2"><i class="fas fa-file-excel text-green-600"></i> Impor Data via Excel</h3>
                <div class="grid grid-cols-1 gap-3">
                    <p class="text-[9px] text-slate-500 font-bold uppercase tracking-tight italic bg-slate-50 p-2 rounded-lg border border-slate-100">* Bisa import Template Daftar Peserta biasa ATAU Template Jadwal dari Panel Operator.</p>
                    <input type="file" id="lot-excel-input" class="hidden" accept=".xlsx, .xls" onchange="handleExcelImport(event)">
                    <button onclick="document.getElementById('lot-excel-input').click()" class="w-full bg-slate-800 text-white py-3 rounded-xl font-black text-[11px] uppercase tracking-widest shadow-md active:scale-95 transition-all"><i class="fas fa-upload mr-2"></i> Pilih File Excel</button>
                </div>
            </div>

            <div class="text-center py-1">
                <div class="h-px bg-slate-300 w-full relative"><span class="absolute top-1/2 left-1/2 -translate-x-1/2 -translate-y-1/2 bg-slate-50 px-4 text-[9px] font-black text-slate-400">ATAU INPUT MANUAL</span></div>
            </div>

            <!-- Form Input Manual -->
            <div class="grid grid-cols-1 gap-4 bg-white p-5 rounded-2xl border border-slate-200 shadow-sm relative">
                <div class="absolute top-0 left-0 w-full h-1 bg-rose-500 rounded-t-2xl"></div>
                
                <!-- HIDDEN FIELD UNTUK EDIT ID -->
                <input type="hidden" id="lot-edit-id" value="">
                
                <div>
                    <label class="label-sekre uppercase">Kategori Usia *</label>
                    <select id="lot-cat" class="input-loting uppercase">
                        <option>USIA DINI 1</option>
                        <option>USIA DINI 2</option>
                        <option>PRA REMAJA</option>
                        <option>REMAJA</option>
                        <option>DEWASA</option>
                    </select>
                </div>
                
                <div class="grid grid-cols-2 gap-4">
                    <div>
                        <label class="label-sekre uppercase">Kelas *</label>
                        <select id="lot-kelas" class="input-loting uppercase">
                            <option value="A">A</option><option value="B">B</option><option value="C">C</option><option value="D">D</option><option value="E">E</option><option value="F">F</option><option value="G">G</option><option value="H">H</option><option value="I">I</option><option value="J">J</option><option value="K">K</option><option value="L">L</option><option value="BEBAS">BEBAS</option>
                        </select>
                    </div>
                    <div>
                        <label class="label-sekre uppercase">Gender *</label>
                        <select id="lot-gender" class="input-loting uppercase">
                            <option>PUTRA</option>
                            <option>PUTRI</option>
                        </select>
                    </div>
                </div>
                
                <div>
                    <label class="label-sekre uppercase">Nama Lengkap Peserta *</label>
                    <input type="text" id="lot-nama" class="input-loting uppercase" placeholder="Masukkan Nama Pesilat">
                </div>
                
                <div>
                    <label class="label-sekre uppercase">Kontingen / Perguruan *</label>
                    <input type="text" id="lot-nama-perguruan" class="input-loting uppercase" placeholder="Masukkan Nama Kontingen">
                </div>
                
                <div>
                    <label class="label-sekre uppercase">Upload Foto (Opsional)</label>
                    <input type="file" id="lot-photo" class="input-loting text-[10px]" accept=".jpg,.jpeg,.png">
                </div>
                
                <button id="lot-save-btn" onclick="addParticipantToLoting()" class="w-full bg-rose-600 text-white py-4 rounded-xl font-black text-[11px] uppercase shadow-lg active:scale-[0.98] transition-all mt-2">
                    <i class="fas fa-save mr-2"></i> Daftarkan Peserta
                </button>
            </div>
        </div>
    </div>

    <!-- PAGE 2: DATA & LOTING -->
    <div id="lot-page-2" class="hidden flex-1 flex flex-col overflow-hidden bg-slate-50">
        
        <!-- Filter & Action Controls -->
        <div class="bg-white p-4 border-b shadow-sm shrink-0 z-10">
            <div class="flex justify-between items-center mb-3">
                <span class="text-[10px] font-black uppercase text-slate-500 italic"><i class="fas fa-filter mr-1"></i> Filter Data Peserta</span>
                <span id="loting-counter-badge" class="bg-rose-100 text-rose-700 px-3 py-1 rounded-lg font-black text-[10px] border border-rose-200">TOTAL: 0</span>
            </div>
            
            <div class="grid grid-cols-3 gap-2 mb-3">
                <select id="lot-f-cat" onchange="applyLotingFilters()" class="text-[9px] sm:text-[10px] font-bold border border-slate-300 rounded-lg px-1 sm:px-2 py-2 outline-none uppercase bg-slate-50 text-slate-700">
                    <option value="SEMUA">Semua Usia</option>
                </select>
                <select id="lot-f-kelas" onchange="applyLotingFilters()" class="text-[9px] sm:text-[10px] font-bold border border-slate-300 rounded-lg px-1 sm:px-2 py-2 outline-none uppercase bg-slate-50 text-slate-700">
                    <option value="SEMUA">Semua Kelas</option>
                </select>
                <select id="lot-f-gender" onchange="applyLotingFilters()" class="text-[9px] sm:text-[10px] font-bold border border-slate-300 rounded-lg px-1 sm:px-2 py-2 outline-none uppercase bg-slate-50 text-slate-700">
                    <option value="SEMUA">Gender</option>
                </select>
            </div>
            
            <div class="grid grid-cols-2 md:grid-cols-5 gap-2">
                <button onclick="executeLoting(false)" class="bg-slate-900 text-white py-3 rounded-lg font-black text-[9px] sm:text-[10px] uppercase shadow-md active:scale-95 flex flex-col sm:flex-row items-center justify-center gap-1">
                    <i class="fas fa-random"></i> Loting Semua
                </button>
                <button onclick="executeLoting(true)" class="bg-indigo-600 text-white py-3 rounded-lg font-black text-[9px] sm:text-[10px] uppercase shadow-md active:scale-95 flex flex-col sm:flex-row items-center justify-center gap-1">
                    <i class="fas fa-filter"></i> Loting Filter
                </button>
                <button onclick="clearAllParticipants()" class="bg-rose-600 text-white py-3 rounded-lg font-black text-[9px] sm:text-[10px] uppercase shadow-md active:scale-95 flex flex-col sm:flex-row items-center justify-center gap-1">
                    <i class="fas fa-trash-alt"></i> Hapus Semua
                </button>
                <button onclick="exportParticipantsExcel()" class="bg-green-600 text-white py-3 rounded-lg font-black text-[9px] sm:text-[10px] uppercase shadow-md active:scale-95 flex flex-col sm:flex-row items-center justify-center gap-1">
                    <i class="fas fa-file-excel"></i> Export Excel
                </button>
                <button onclick="exportParticipantsPDF()" class="bg-amber-500 text-white py-3 rounded-lg font-black text-[9px] sm:text-[10px] uppercase shadow-md active:scale-95 flex flex-col sm:flex-row items-center justify-center gap-1">
                    <i class="fas fa-file-pdf"></i> Export PDF
                </button>
            </div>
        </div>

        <!-- Data Table -->
        <div id="lot-table-pdf-target" class="flex-1 overflow-auto custom-scroll p-3 sm:p-4">
            <div class="bg-white rounded-xl shadow-sm border border-slate-200 overflow-hidden">
                <table id="loting-data-table" class="w-full text-[10px] border-collapse">
                    <thead class="bg-slate-800 text-white uppercase sticky top-0 z-10">
                        <tr>
                            <th class="p-3 text-center border-r border-slate-700">No</th>
                            <th class="p-3 text-left border-r border-slate-700">Peserta & Kontingen</th>
                            <th class="p-3 text-center border-r border-slate-700">Kelas</th>
                            <th class="p-3 text-center border-r border-slate-700">Usia</th>
                            <th class="p-3 text-center border-r border-slate-700">Gender</th>
                            <th class="p-3 text-center">Aksi</th>
                        </tr>
                    </thead>
                    <tbody id="loting-table-body" class="font-bold uppercase text-slate-700">
                        <!-- Data Rendered Here -->
                    </tbody>
                </table>
            </div>
        </div>
        
        <!-- PAGINATION CONTROL LOTING -->
        <div class="bg-white p-3 border-t border-slate-200 flex justify-between items-center shrink-0 z-10 shadow-[0_-4px_6px_-1px_rgba(0,0,0,0.05)]">
            <button onclick="changeLotingPage(-1)" class="bg-slate-100 border border-slate-300 text-slate-600 px-4 py-2 rounded-lg text-[10px] font-black uppercase active:scale-95 transition-all">Prev</button>
            <div class="text-center">
                <span id="loting-page-info" class="text-[11px] font-black text-rose-600 italic">Hal 1 / 1</span>
            </div>
            <button onclick="changeLotingPage(1)" class="bg-slate-100 border border-slate-300 text-slate-600 px-4 py-2 rounded-lg text-[10px] font-black uppercase active:scale-95 transition-all">Next</button>
        </div>
    </div>

    <!-- PAGE 3: HASIL LOTING -->
    <div id="lot-page-3" class="hidden flex-1 flex flex-col overflow-hidden bg-slate-50">
        <!-- Header Controls & Filters -->
        <div class="bg-white p-4 border-b shadow-sm shrink-0 z-10">
            <div class="flex flex-col sm:flex-row justify-between items-start sm:items-center gap-3 mb-3">
                <span class="text-[10px] font-black uppercase text-slate-500 italic"><i class="fas fa-list mr-1"></i> Jadwal Hasil Loting</span>
                <div class="flex gap-2">
                    <button onclick="exportHasilLotingExcel()" class="bg-green-600 text-white py-2 px-3 rounded-lg font-black text-[9px] uppercase shadow-md active:scale-95 flex items-center gap-2">
                        <i class="fas fa-file-excel"></i> Export Excel
                    </button>
                    <button onclick="exportHasilLotingPDF()" class="bg-rose-600 text-white py-2 px-3 rounded-lg font-black text-[9px] uppercase shadow-md active:scale-95 flex items-center gap-2">
                        <i class="fas fa-file-pdf"></i> Export PDF
                    </button>
                </div>
            </div>
            
            <!-- Tambahan Filter Hasil Loting -->
            <div class="grid grid-cols-3 gap-2">
                <select id="hasil-f-cat" onchange="applyHasilFilters()" class="text-[9px] sm:text-[10px] font-bold border border-slate-300 rounded-lg px-1 sm:px-2 py-2 outline-none uppercase bg-slate-50 text-slate-700">
                    <option value="SEMUA">Semua Usia</option>
                </select>
                <select id="hasil-f-kelas" onchange="applyHasilFilters()" class="text-[9px] sm:text-[10px] font-bold border border-slate-300 rounded-lg px-1 sm:px-2 py-2 outline-none uppercase bg-slate-50 text-slate-700">
                    <option value="SEMUA">Semua Kelas</option>
                </select>
                <select id="hasil-f-gender" onchange="applyHasilFilters()" class="text-[9px] sm:text-[10px] font-bold border border-slate-300 rounded-lg px-1 sm:px-2 py-2 outline-none uppercase bg-slate-50 text-slate-700">
                    <option value="SEMUA">Gender</option>
                </select>
            </div>
        </div>
        
        <!-- Data Table Hasil -->
        <div class="flex-1 overflow-auto custom-scroll p-3 sm:p-4">
            <div class="bg-white rounded-xl shadow-sm border border-slate-200 overflow-hidden">
                <table class="w-full text-[9px] sm:text-[10px] border-collapse">
                    <thead class="bg-slate-800 text-white uppercase sticky top-0 z-10">
                        <tr>
                            <th class="p-2 border border-slate-700">No</th>
                            <th class="p-2 border border-slate-700">Partai</th>
                            <th class="p-2 border border-slate-700">Fase</th>
                            <th class="p-2 border border-slate-700">Kategori</th>
                            <th class="p-2 border border-slate-700 bg-blue-600 text-white shadow-inner">Peserta (Biru)</th>
                            <th class="p-2 border border-slate-700 bg-blue-600 text-white shadow-inner">Kontingen (Biru)</th>
                            <th class="p-2 border border-slate-700 bg-blue-600 text-white shadow-inner">BB (Biru)</th>
                            <th class="p-2 border border-slate-700 bg-red-600 text-white shadow-inner">Peserta (Merah)</th>
                            <th class="p-2 border border-slate-700 bg-red-600 text-white shadow-inner">Kontingen (Merah)</th>
                            <th class="p-2 border border-slate-700 bg-red-600 text-white shadow-inner">BB (Merah)</th>
                        </tr>
                    </thead>
                    <tbody id="hasil-loting-table-body" class="font-bold uppercase text-slate-700 text-center">
                        <!-- Data Rendered Here -->
                    </tbody>
                </table>
            </div>
        </div>
        
        <!-- PAGINATION CONTROL HASIL LOTING -->
        <div class="bg-white p-3 border-t border-slate-200 flex justify-between items-center shrink-0 z-10 shadow-[0_-4px_6px_-1px_rgba(0,0,0,0.05)]">
            <button onclick="changeHasilLotingPage(-1)" class="bg-slate-100 border border-slate-300 text-slate-600 px-4 py-2 rounded-lg text-[10px] font-black uppercase active:scale-95 transition-all">Prev</button>
            <div class="text-center">
                <span id="hasil-loting-page-info" class="text-[11px] font-black text-rose-600 italic">Hal 1 / 1</span>
            </div>
            <button onclick="changeHasilLotingPage(1)" class="bg-slate-100 border border-slate-300 text-slate-600 px-4 py-2 rounded-lg text-[10px] font-black uppercase active:scale-95 transition-all">Next</button>
        </div>
    </div>

<script type="module">
    import { initializeApp } from "https://www.gstatic.com/firebasejs/10.7.1/firebase-app.js";
    import { getDatabase, ref, set, onValue } from "https://www.gstatic.com/firebasejs/10.7.1/firebase-database.js";

    // Konfigurasi Firebase
    const firebaseConfig = {
  apiKey: "AIzaSyB_ef29_Y-kxHNVh7wPdxrtg4o5tLBdRvA",
  authDomain: "usia-dini.firebaseapp.com",
  databaseURL: "https://usia-dini-default-rtdb.asia-southeast1.firebasedatabase.app",
  projectId: "usia-dini",
  storageBucket: "usia-dini.firebasestorage.app",
  messagingSenderId: "954421123766",
  appId: "1:954421123766:web:e6db6346e2403a8ba26417"
};
    
    const app = initializeApp(firebaseConfig);
    const database = getDatabase(app);
    const dbRef = ref(database, 'pencak_scoring_state');

    // Initial State
    const INITIAL_STATE = {
        participants: [], 
        matches: Array.from({length: 1000}, (_, i) => ({ 
            p: i+1, m: "", b: "", km: "", kb: "", cat: "USIA DINI 2", kelas: "A", gender: "PUTRA", fase: "PENYISIHAN", status: 'idle', totalM: 0, totalB: 0, winner: "", winnerSide: "",
            biruStatus: "", merahStatus: "", maxBabak: 3, maxTimer: 120, nextP: null, photoB: "", photoM: "", beratB: "", beratM: ""
        }))
    };

    window.state = INITIAL_STATE;
    window.lotingCurrentPage = 0;
    window.hasilLotingCurrentPage = 0;
    
    window.lotingFilterCat = 'SEMUA'; 
    window.lotingFilterKelas = 'SEMUA'; 
    window.lotingFilterGender = 'SEMUA';

    window.hasilFilterCat = 'SEMUA'; 
    window.hasilFilterKelas = 'SEMUA'; 
    window.hasilFilterGender = 'SEMUA';

    // Sync Firebase
    onValue(dbRef, (snapshot) => {
        const data = snapshot.val();
        if (data) { 
            window.state = data; 
            renderLotingTable();
            renderHasilLotingTable();
        } else { 
            set(dbRef, INITIAL_STATE); 
        }
    });

    window.broadcast = function(path = "", value = null) {
        if (path !== "") { 
            const specificRef = ref(database, 'pencak_scoring_state/' + path); 
            set(specificRef, value); 
        } else { 
            set(dbRef, window.state); 
        }
    }

    window.showNotif = function() { 
        const n = document.getElementById('save-ani'); 
        n.classList.add('show'); 
        setTimeout(() => n.classList.remove('show'), 2000); 
    }

    window.switchLotingPage = function(pageNum) {
        document.getElementById('lot-page-1').classList.toggle('hidden', pageNum !== 1);
        document.getElementById('lot-page-2').classList.toggle('hidden', pageNum !== 2);
        document.getElementById('lot-page-3').classList.toggle('hidden', pageNum !== 3);
        
        document.getElementById('lot-tab-1').classList.toggle('active', pageNum === 1);
        document.getElementById('lot-tab-2').classList.toggle('active', pageNum === 2);
        document.getElementById('lot-tab-3').classList.toggle('active', pageNum === 3);
        
        if(pageNum === 2) renderLotingTable();
        if(pageNum === 3) renderHasilLotingTable();
    }

    window.addParticipantToLoting = function() {
        const editId = document.getElementById('lot-edit-id').value;
        const cat = document.getElementById('lot-cat').value.toString().trim().toUpperCase();
        const kelas = document.getElementById('lot-kelas').value.toString().trim().toUpperCase();
        const gender = document.getElementById('lot-gender').value.toString().trim().toUpperCase();
        const nama = document.getElementById('lot-nama').value.toUpperCase();
        const kont = document.getElementById('lot-nama-perguruan').value.toUpperCase();
        const rCount = 3; 
        const timer = 120;
        const photoInput = document.getElementById('lot-photo');
        
        if(!nama || !kelas || !kont) { 
            alert("Mohon lengkapi data yang bertanda bintang (*)"); 
            return; 
        }

        const processSave = (photoUrl = "") => {
            let current = window.state.participants || [];
            if(editId) {
                const idx = current.findIndex(p => p.id == editId);
                if(idx > -1) {
                    const oldPhoto = current[idx].photo;
                    current[idx] = { ...current[idx], cat, kelas, gender, nama, kont, photo: photoUrl || oldPhoto };
                }
            } else {
                current.push({ id: Date.now(), cat, kelas, gender, nama, kont, photo: photoUrl, round: rCount, timer: timer });
            }
            window.broadcast('participants', current);
            
            // RESET FORM
            document.getElementById('lot-edit-id').value = "";
            document.getElementById('lot-nama').value = "";
            document.getElementById('lot-nama-perguruan').value = "";
            document.getElementById('lot-photo').value = "";
            document.getElementById('lot-save-btn').innerHTML = `<i class="fas fa-save mr-2"></i> Daftarkan Peserta`;
            
            showNotif();
            setTimeout(() => { switchLotingPage(2); }, 500);
        }

        if(photoInput.files && photoInput.files[0]) {
            const reader = new FileReader();
            reader.onload = (e) => processSave(e.target.result);
            reader.readAsDataURL(photoInput.files[0]);
        } else { processSave(""); }
    }

    window.editParticipantLoting = function(id) {
        const p = window.state.participants.find(x => x.id == id);
        if(p) {
            document.getElementById('lot-edit-id').value = p.id;
            document.getElementById('lot-cat').value = p.cat;
            document.getElementById('lot-kelas').value = p.kelas;
            document.getElementById('lot-gender').value = p.gender;
