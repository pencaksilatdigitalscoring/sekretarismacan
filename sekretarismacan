    window.handleExcelImport = function(event) {
        const file = event.target.files[0];
        if (!file) return;
        
        const notif = document.getElementById('save-ani');
        notif.innerHTML = '<i class="fas fa-spinner fa-spin mr-2"></i> Mengimpor Data...';
        notif.classList.add('show');

        const reader = new FileReader();
        reader.onload = function(e) {
            try {
                const data = new Uint8Array(e.target.result);
                const workbook = XLSX.read(data, { type: 'array' });
                const firstSheet = workbook.Sheets[workbook.SheetNames[0]];
                const jsonData = XLSX.utils.sheet_to_json(firstSheet, {defval: ""});
                
                const currentParticipants = window.state.participants || [];
                let importCount = 0;
                
                jsonData.forEach(row => {
                    const keys = Object.keys(row);
                    const getVal = (possibleNames) => {
                        for(let k of keys) {
                            if(possibleNames.some(pn => k.toUpperCase().includes(pn))) return row[k].toString().trim();
                        }
                        return "";
                    };

                    let namaBiru = getVal(["NAMA PESERTA (BIRU)", "NAMA BIRU"]);
                    let namaMerah = getVal(["NAMA PESERTA (MERAH)", "NAMA MERAH"]);
                    let katFormat = getVal(["KATEGORI"]);

                    if(katFormat && (namaBiru || namaMerah)) {
                        let kParts = katFormat.split(" ");
                        let kelas = (kParts[0] || "A").toString().trim().toUpperCase();
                        let gender = (katFormat.toUpperCase().includes("PUTRI") || katFormat.toUpperCase().includes("PI")) ? "PUTRI" : "PUTRA";
                        let cat = (kParts.slice(1).join(" ").replace(/(PUTRA|PUTRI|PI|PA)/ig, '').trim() || "DEWASA").toUpperCase();

                        if(namaBiru && namaBiru !== "BYE" && !namaBiru.includes("PEMENANG")) {
                            currentParticipants.push({
                                id: Date.now() + Math.random(),
                                cat: cat, kelas: kelas, gender: gender,
                                nama: namaBiru.toUpperCase(),
                                kont: (getVal(["KONTINGEN (BIRU)", "KONTINGEN BIRU"]) || "-").toUpperCase(),
                                photo: "", round: 3, timer: 120
                            });
                            importCount++;
                        }
                        if(namaMerah && namaMerah !== "BYE" && !namaMerah.includes("PEMENANG")) {
                            currentParticipants.push({
                                id: Date.now() + Math.random(),
                                cat: cat, kelas: kelas, gender: gender,
                                nama: namaMerah.toUpperCase(),
                                kont: (getVal(["KONTINGEN (MERAH)", "KONTINGEN MERAH"]) || "-").toUpperCase(),
                                photo: "", round: 3, timer: 120
                            });
                            importCount++;
                        }
                    } else {
                        const nama = getVal(["NAMA", "PESERTA"]).toUpperCase();
                        const kont = getVal(["KONTINGEN", "PERGURUAN", "ASAL"]).toUpperCase();
                        const kelas = getVal(["KELAS"]).toString().trim().toUpperCase();
                        const cat = (getVal(["KATEGORI", "USIA"]) || "DEWASA").toString().trim().toUpperCase();
                        const gender = (getVal(["GENDER", "JENIS KELAMIN", "KELAMIN"]) || "PUTRA").toString().trim().toUpperCase();

                        if (nama && kont && kelas) {
                            currentParticipants.push({
                                id: Date.now() + Math.random(),
                                cat: cat, kelas: kelas, gender: gender,
                                nama: nama, kont: kont, photo: "", round: 3, timer: 120
                            });
                            importCount++;
                        }
                    }
                });

                if (importCount > 0) {
                    window.broadcast('participants', currentParticipants);
                    notif.innerHTML = `<i class="fas fa-check-circle mr-2"></i> ${importCount} Data Diimpor!`;
                    setTimeout(() => notif.classList.remove('show'), 2000);
                    switchLotingPage(2);
                } else {
                    notif.classList.remove('show');
                    alert("Tidak ada data yang valid. Pastikan header kolom sesuai Format Operator atau Format Peserta.");
                }
            } catch (error) {
                console.error(error);
                notif.classList.remove('show');
                alert("Gagal membaca file Excel. File mungkin rusak atau tidak didukung.");
            }
            event.target.value = ""; 
        };
        reader.readAsArrayBuffer(file);
    }

