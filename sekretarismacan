                        <div class="flex items-center">
                            ${photoIcon}
                            <div class="overflow-hidden">
                                <div class="text-[11px] font-black text-slate-800 uppercase truncate">${p.nama}</div>
                                <div class="text-[9px] text-rose-600 font-bold tracking-tight uppercase truncate">${p.kont}</div>
                            </div>
                        </div>
                    </td>
                    <td class="p-3 text-center uppercase font-black text-slate-700 border-r border-slate-200 text-xs">${p.kelas}</td>
                    <td class="p-3 text-center uppercase border-r border-slate-200">
                        <span class="bg-blue-50 text-blue-700 px-2 py-1 rounded text-[9px] font-black">${p.cat}</span>
                    </td>
                    <td class="p-3 text-center uppercase font-bold text-slate-500 text-[10px] border-r border-slate-200">${p.gender}</td>
                    <td class="p-3 text-center">
                        <div class="flex items-center justify-center gap-3">
                            <button onclick="editParticipantLoting(${p.id})" class="text-blue-500 hover:text-blue-700 active:scale-90 text-sm"><i class="fas fa-edit"></i></button>
                            <button onclick="deleteParticipantLoting(${p.id})" class="text-rose-500 hover:text-rose-700 active:scale-90 text-sm"><i class="fas fa-trash-alt"></i></button>
                        </div>
                    </td>
                </tr>`
            }).join('');
        }
    }

    // --- ALGORITMA LOTING: BERPASANGAN LANGSUNG & GUGUR TUNGGAL --- 
    window.executeLoting = function(useFilter = false) {
        let list = window.state.participants || [];
        
        if (useFilter) {
            list = list.filter(p => 
                (window.lotingFilterCat === 'SEMUA' || p.cat === window.lotingFilterCat) && 
                (window.lotingFilterKelas === 'SEMUA' || p.kelas === window.lotingFilterKelas) && 
                (window.lotingFilterGender === 'SEMUA' || p.gender === window.lotingFilterGender)
            );
            if(list.length < 1) { 
                alert("Tidak ada peserta pada filter saat ini."); 
                return; 
            }
            if(!confirm("Peringatan: Jadwal bagan sebelumnya akan tetap disimpan. Loting ini HANYA akan membuat bagan/jadwal baru untuk kategori yang difilter. Lanjutkan?")) return;
        } else {
            if(list.length < 1) { 
                alert("Harus ada peserta yang terdaftar untuk melakukan loting."); 
                return; 
            }
            if(!confirm("Peringatan: Loting akan mereset jadwal yang sudah ada dan membuat bagan baru untuk SEMUA data peserta. Lanjutkan?")) return;
        }
        
        let existingMatches = window.state.matches.filter(m => m.m || m.b);
        let groupsToRegenerate = new Set();
        list.forEach(p => groupsToRegenerate.add(`${p.cat}|${p.kelas}|${p.gender}`));

        if (useFilter) {
            existingMatches = existingMatches.filter(m => !groupsToRegenerate.has(`${m.cat}|${m.kelas}|${m.gender}`));
        } else {
            existingMatches = []; 
        }

        const groups = {};
        list.forEach(p => { 
            const key = `${p.cat}|${p.kelas}|${p.gender}`; 
            if(!groups[key]) groups[key] = []; 
            groups[key].push(p); 
        });
        
        const sortedGroupKeys = Object.keys(groups).sort((a,b) => groups[b].length - groups[a].length);
        
        let generatedMatches = [];
        let tempPIdx = 10000; 
        
        for(const k of sortedGroupKeys) {
            let pool = [...groups[k]];
            
            // Acak (Shuffle) posisi peserta
            for (let i = pool.length - 1; i > 0; i--) { 
                const j = Math.floor(Math.random() * (i + 1)); 
                [pool[i], pool[j]] = [pool[j], pool[i]]; 
            }
            
            let catParties = [];
            let currentNodes = pool.map(p => ({ type: 'player', data: p }));

            while (currentNodes.length > 1) {
                let nextNodes = [];
                let matchCount = Math.floor(currentNodes.length / 2);
                let hasBye = currentNodes.length % 2 !== 0; 

                // Pasangkan nodes 1 per 1
                for (let i = 0; i < matchCount; i++) {
                    let n1 = currentNodes[i * 2];
                    let n2 = currentNodes[i * 2 + 1];

                    const m = {...INITIAL_STATE.matches[0]};
                    const info = groups[k][0];
                    m.cat = info.cat; 
                    m.kelas = info.kelas; 
                    m.gender = info.gender; 
                    m.maxBabak = info.round || 3; 
                    m.maxTimer = info.timer || 120;
                    m.p = tempPIdx++;

                    // Konfigurasi Sudut Biru
                    if (n1.type === 'player') {
                        m.b = n1.data.nama; m.kb = n1.data.kont; m.photoB = n1.data.photo;
                    } else {
                        let prevMatch = catParties.find(x => x.p === n1.matchId);
                        m.b = "PEMENANG PARTAI " + n1.matchId;
                        m.kb = "---";
                        m.photoB = "";
                        if (prevMatch) prevMatch.nextP = { p: m.p, side: 'biru' };
                    }

                    // Konfigurasi Sudut Merah
                    if (n2.type === 'player') {
                        m.m = n2.data.nama; m.km = n2.data.kont; m.photoM = n2.data.photo;
                    } else {
                        let prevMatch = catParties.find(x => x.p === n2.matchId);
                        m.m = "PEMENANG PARTAI " + n2.matchId;
                        m.km = "---";
                        m.photoM = "";
                        if (prevMatch) prevMatch.nextP = { p: m.p, side: 'merah' };
                    }
                    
                    catParties.push(m);
                    nextNodes.push({ type: 'match', matchId: m.p });
                }

                // Sisa 1 peserta/tim yang ganjil (BYE)
                // TIDAK dibuatkan partai dummy.
                // Langsung dipindahkan ke nextNodes.
                if (hasBye) {
                    let oddNode = currentNodes[currentNodes.length - 1];
                    // Disisipkan di posisi indeks 1 agar bertemu dan melawan langsung Pemenang Partai awal
                    if (nextNodes.length > 0) {
                        nextNodes.splice(1, 0, oddNode);
                    } else {
                        nextNodes.push(oddNode);
                    }
                }

                currentNodes = nextNodes;
            }

            // Penentuan Fase dengan menyusuri relasi dari Final (Root Node)
            if (catParties.length > 0) {
                let finalMatch = catParties[catParties.length - 1]; 
                finalMatch.fase = "FINAL";
                finalMatch.distance = 0;

                let queue = [finalMatch];
                while (queue.length > 0) {
                    let curr = queue.shift();
                    
                    let children = catParties.filter(x => x.nextP && x.nextP.p === curr.p);
                    for (let child of children) {
                        child.distance = curr.distance + 1;
                        if (child.distance === 1) child.fase = "SEMI FINAL";
                        else if (child.distance === 2) child.fase = "PEREMPAT FINAL";
                        else child.fase = "PENYISIHAN";
                        
                        queue.push(child);
                    }
                }
            }
            
            generatedMatches.push(...catParties);
        }
        
        // 1. GABUNGKAN MATCH LAMA + BARU
        let allMatches = [...existingMatches, ...generatedMatches];
        
        // Hitung total peserta pada semua kategori di dalam AllMatches
        const catCount = {};
        window.state.participants.forEach(p => {
            let key = `${p.cat}|${p.kelas}|${p.gender}`;
            catCount[key] = (catCount[key] || 0) + 1;
        });

        // 2. SORTIR KESELURUHAN JADWAL
        const phaseWeight = { "PENYISIHAN": 1, "PEREMPAT FINAL": 2, "SEMI FINAL": 3, "FINAL": 4 };
        allMatches.forEach((m, idx) => m.originalOrder = idx);

        allMatches.sort((a, b) => {
            let wA = phaseWeight[a.fase] || 0;
            let wB = phaseWeight[b.fase] || 0;
            if (wA !== wB) return wA - wB; // Prioritas 1: Kumpulkan seluruh Fase yang sama agar Final bersama
            
            let keyA = `${a.cat}|${a.kelas}|${a.gender}`;
            let keyB = `${b.cat}|${b.kelas}|${b.gender}`;
            
            let countA = catCount[keyA] || 0;
            let countB = catCount[keyB] || 0;
            
            if (countA !== countB) return countB - countA; // Prioritas 2: Kategori dengan Peserta Terbanyak
            if (keyA !== keyB) return keyA.localeCompare(keyB); // Prioritas 3: Pengelompokkan Kategori Identik
            
            return a.originalOrder - b.originalOrder; // Prioritas 4: Pertahankan alur bagan
        });
        
        // 3. PEMETAAN ULANG PARTAI (P)
        let pMap = {};
        allMatches.forEach((m, index) => {
            pMap[m.p] = index + 1;
            m.new_p = index + 1;
        });
        
        // Update referensi String dan Objek Partai
        allMatches.forEach(m => {
            if (m.nextP && m.nextP.p) {
                m.nextP.p = pMap[m.nextP.p];
            }
            if (m.b && m.b.startsWith("PEMENANG PARTAI ")) {
                let oldPartai = parseInt(m.b.replace("PEMENANG PARTAI ", ""));
                if(pMap[oldPartai]) m.b = "PEMENANG PARTAI " + pMap[oldPartai];
            }
            if (m.m && m.m.startsWith("PEMENANG PARTAI ")) {
                let oldPartai = parseInt(m.m.replace("PEMENANG PARTAI ", ""));
                if(pMap[oldPartai]) m.m = "PEMENANG PARTAI " + pMap[oldPartai];
            }
            m.p = m.new_p;
            delete m.new_p;
            delete m.originalOrder;
        });
        
        // Inject kembali ke Array Utama 1000 partai
        const updatedMatches = INITIAL_STATE.matches.map(m => ({...m}));
        for(let i=0; i<updatedMatches.length; i++) {
            if(i < allMatches.length) {
                updatedMatches[i] = allMatches[i];
            } else {
                updatedMatches[i] = {...INITIAL_STATE.matches[i]};
                updatedMatches[i].p = i + 1;
            }
        }
        
        window.broadcast('matches', updatedMatches);
        alert("Loting Berhasil! Anda akan dialihkan ke Tab Hasil Loting."); 
        switchLotingPage(3);
    }

</script>
